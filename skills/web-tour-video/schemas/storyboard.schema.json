{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Web Tour Video Storyboard",
  "type": "object",
  "required": [
    "url",
    "steps"
  ],
  "properties": {
    "url": {
      "type": "string"
    },
    "storageState": {
      "type": "string"
    },
    "video": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 2
        },
        "height": {
          "type": "integer",
          "minimum": 2
        }
      },
      "additionalProperties": false
    },
    "tts": {
      "type": "object",
      "properties": {
        "baseUrl": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "voice": {
          "type": "string"
        },
        "responseFormat": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "chrome": {
      "type": "object",
      "required": [
        "height"
      ],
      "properties": {
        "height": {
          "type": "integer",
          "minimum": 40
        },
        "title": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "lexicon": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "match",
          "tts"
        ],
        "properties": {
          "match": {
            "type": "string",
            "minLength": 1
          },
          "tts": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "narration",
          "actions"
        ],
        "properties": {
          "narration": {
            "type": "string",
            "minLength": 1
          },
          "tts_text": {
            "type": "string"
          },
          "actions": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "type",
                    "url"
                  ],
                  "properties": {
                    "type": {
                      "const": "goto"
                    },
                    "url": {
                      "type": "string"
                    },
                    "waitAfter": {
                      "type": "number"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "selector"
                  ],
                  "properties": {
                    "type": {
                      "const": "click"
                    },
                    "selector": {
                      "type": "string"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "selector",
                    "text"
                  ],
                  "properties": {
                    "type": {
                      "const": "type"
                    },
                    "selector": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "delay": {
                      "type": "number"
                    },
                    "clear": {
                      "type": "boolean"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "const": "scroll"
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "selector"
                  ],
                  "properties": {
                    "type": {
                      "const": "hover"
                    },
                    "selector": {
                      "type": "string"
                    },
                    "ms": {
                      "type": "number"
                    }
                  }
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "ms"
                  ],
                  "properties": {
                    "type": {
                      "const": "wait"
                    },
                    "ms": {
                      "type": "number"
                    }
                  }
                }
              ]
            }
          },
          "chromeUrl": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}